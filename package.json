{
  "name": "worktree-ports",
  "version": "0.1.0",
  "description": "Give every git worktree its own stable block of local ports, so the dev servers of two checkouts never collide.",
  "keywords": [
    "git",
    "worktree",
    "git-worktree",
    "ports",
    "port",
    "dev-server",
    "monorepo",
    "cli",
    "env"
  ],
  "author": "Jim Beveridge",
  "homepage": "https://github.com/jimbeveridge/worktree-ports#readme",
  "bugs": {
    "url": "https://github.com/jimbeveridge/worktree-ports/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimbeveridge/worktree-ports.git"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "worktree-ports": "./dist/bin/worktree-ports.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --import ./test/setup.ts \"test/*.test.ts\"",
    "test:e2e": "node --test --import ./test/setup.ts \"test/e2e/*.test.ts\"",
    "lint": "prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22",
    "prettier": "^3",
    "typescript": "^5.9"
  }
}
